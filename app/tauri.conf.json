{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repo Launcher",
  "version": "0.1.0",
  "identifier": "app.repolauncher.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter ui dev",
    "beforeBuildCommand": "pnpm --filter ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Repo Launcher",
        "width": 1040,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Repo Launcher contributors",
    "homepage": "https://github.com/swissmarley/repo-launcher",
    "license": "MIT OR Apache-2.0",
    "copyright": "© 2026 Repo Launcher contributors",
    "category": "DeveloperTool",
    "shortDescription": "Install and launch GitHub projects in one click",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Paste a link to a project on GitHub, click Install, then Launch. Repo Launcher sets up everything the project needs in its own folder and starts it. No git, Python, Node or terminal needed.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "windows/uninstall.wxs"
        ],
        "componentGroupRefs": [
          "RepoLauncherUninstall"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "repolauncher"
        ]
      }
    }
  }
}
